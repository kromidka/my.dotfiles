#!/bin/sh

# Navigate to your dotfiles directory
DOTFILES_DIR="$HOME/git/my.dotfiles"
cd "$DOTFILES_DIR" || exit 1

# Check for changes
if [ -n "$(git status --porcelain)" ]; then
    # Stage changes
    git add .

    # Use fuzzel to get the commit message
    # -d: dmenu mode
    # -p: prompt text
    commit_msg=$(printf "" | fuzzel --minimal-lines -d -p "Commit Message: " --placeholder="Message:")

    # Check if user cancelled (Esc/Empty)
    if [ -z "$commit_msg" ]; then
        echo "Sync cancelled by user."
        exit 0
    fi

    # Commit and Push
    if git commit -m "$commit_msg"; then
        # Notify user (optional: requires libnotify/dunst/mako)
        git push origin main && \
        command -v notify-send >/dev/null && notify-send "Dotfiles" "Synced successfully!"
    else
        command -v notify-send >/dev/null && notify-send "Dotfiles" "Error: Commit failed."
        exit 1
    fi
else
    command -v notify-send >/dev/null && notify-send "Dotfiles" "Already up to date."
fi
