layout {

    focus-ring {
        active-color   "#c0cab6"
        inactive-color "#131412"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c0cab6"
        inactive-color "#131412"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c0cab6"
        inactive-color "#40493a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c0cab680"
    }
}

recent-windows {
    highlight {
        active-color "#c0cab6"
        urgent-color "#ffb4ab"
    }
}
