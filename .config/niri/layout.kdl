layout {
	gaps 8
	
	center-focused-column "never"
	//center-focused-column "on-overflow"
	
	preset-column-widths {
		proportion 0.5
		proportion 0.7
	}
//	preset-widows-heights {
//		proportion 0.5
//	}

	// default-column-width { proportion 0.7; }
	//default-column-width {}


	focus-ring {
		width 1.5
		active-color "orange"
		inactive-color "#505050"
		//active-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
	}

	border {
		off
		
		width 2
		active-color "orange"
		inactive-color "#505050"
		
		urgent-color "#9b0000"
	}
}

	prefer-no-csd

window-rule {
	draw-border-with-background false
}


window-rule {
	match title="^Picture-in-Picture$"
	open-floating true
	default-floating-position x=50 y=50 relative-to="bottom-right"
	default-column-width { fixed 485; }
	default-window-height { fixed 276; }
}

window-rule {
	match title="^Picture in picture$"
	open-floating true
	default-floating-position x=50 y=50 relative-to="bottom-right"
	default-column-width { fixed 485; }
	default-window-height { fixed 276; }
}

window-rule {
	match app-id=r#"firefox$"# title="^Picture-in-picture$"
	open-floating true
}

window-rule {
	geometry-corner-radius 8
	clip-to-geometry true
}

layer-rule {
	match namespace="^noctalia-overview*"
	place-within-backdrop true
	}

window-rule {
	match app-id="brave-browser"
	// default-column-width { proportion 0.8;}
	open-maximized true
}

window-rule {
	match app-id="org.kde.dolphin"
	open-maximized true
}


window-rule {
	match app-id="^affinity*"
	open-maximized true
}

window-rule {
    match app-id="mpv"
    open-maximized true
}

window-rule {
	match app-id="org.kde.kcalc"
	open-floating true
}

window-rule {
	match title="^Bitwarden$"
	open-floating true
    	default-floating-position x=15 y=15 relative-to="top-right"
    	default-column-width { fixed 600; }
    	default-window-height { fixed 800; }
}

window-rule {
	match app-id="brave-nngceckbapebfimnlniiiahkandclblb-Default"
	open-floating true
    	default-floating-position x=20 y=20 relative-to="top-right"
}

window-rule {
    match app-id="rmpc-float"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="float"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="org.telegram.desktop"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 1000; }
    default-floating-position x=50 y=50 relative-to="bottom-right"
}

window-rule {
    match app-id="brave-duckduckgo.com__-Default"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

window-rule {
	match app-id="nl.jknaapen.fladder"
	open-maximized true
}

