{
  "commands": [
    {
      "name": "Mount",
      "command": "sh -lc 'pass=$(fuzzel --minimal-lines --dmenu --password --prompt \"Sudo Password: \"); [ -n \"$pass\" ] && echo \"$pass\" | sudo -S mount -a'",
